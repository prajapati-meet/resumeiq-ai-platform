<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- This is the PARENT project. It is not a runnable app.
         Its job is to manage shared config for all child modules. -->
    <groupId>com.resumeanalyzer</groupId>
    <artifactId>resume-analyzer-platform</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Resume Analyzer Platform</name>
    <description>AI-Powered Resume Analyzer - Parent Project</description>

    <!-- List of all microservices (child modules) -->
    <modules>

        <module>auth-service</module>
        <module>api-gateway</module>
      <module>resume-service</module>
        <!--<module>ai-service</module>-->
    </modules>

    <!-- Spring Boot gives us dependency management for free -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <!-- Java version set ONCE here, applies to ALL child modules -->
    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2023.0.3</spring-cloud.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <maven.compiler.release>21</maven.compiler.release>

    </properties>

    <!-- Spring Cloud versions managed centrally -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <source>21</source>
                        <target>21</target>
                        <release>21</release>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>